{
  "name": "nexacore-api",
  "version": "0.1.0",
  "private": true,
  "description": "NexaCore multi-tenant platform API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "db:generate": "prisma generate",
    "db:deploy": "node prisma/deploy.js",
    "db:seed": "node prisma/seed.js",
    "email:worker": "node src/workers/email-outbox.js",
    "test:integration": "node --test test/integration/*.test.js",
    "platform:bootstrap-admin": "node prisma/bootstrap-platform-admin.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "embedded-postgres": "^17.11.0-beta.19",
    "prisma": "^6.19.3",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
