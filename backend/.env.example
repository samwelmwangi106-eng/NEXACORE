NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nexacore:nexacore_dev@localhost:5432/nexacore?schema=public
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
MAIL_MODE=console
MAIL_FROM=noreply@example.test
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_OUTBOX_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
