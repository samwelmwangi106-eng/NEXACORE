generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Industry {
  SCHOOL
  SACCO
  CLINIC
  RENTAL
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum EmailDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum SchoolTermStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum SchoolGradeLevelStatus {
  ACTIVE
  INACTIVE
}

enum SchoolClassSectionStatus {
  PLANNED
  ACTIVE
  CLOSED
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  email              String               @unique @db.VarChar(320)
  passwordHash       String               @map("password_hash") @db.VarChar(255)
  firstName          String               @map("first_name") @db.VarChar(100)
  lastName           String               @map("last_name") @db.VarChar(100)
  status             AccountStatus        @default(ACTIVE)
  emailVerifiedAt    DateTime?            @map("email_verified_at") @db.Timestamptz(6)
  tokenVersion       Int                  @default(0) @map("token_version")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships        OrganisationMember[]
  sessions           RefreshSession[]
  authTokens         AuthToken[]
  invitationsSent    OrganisationInvitation[] @relation("InvitationActor")
  platformGrants     PlatformAdminGrant[]   @relation("PlatformGrantTarget")
  grantsIssued       PlatformAdminGrant[]   @relation("PlatformGrantActor")
  auditEvents        AuditLog[]             @relation("AuditActor")

  @@map("users")
}

model Organisation {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @db.VarChar(180)
  slug        String               @unique @db.VarChar(100)
  industry    Industry
  status      String               @default("ACTIVE") @db.VarChar(30)
  settings    Json                 @default("{}")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships OrganisationMember[]
  roles       Role[]
  memberRoles  MemberRole[]
  invitations OrganisationInvitation[]
  auditLogs    AuditLog[]
  schoolProfile SchoolProfile?
  schoolYears   SchoolAcademicYear[]
  schoolGrades  SchoolGradeLevel[]
  schoolSections SchoolClassSection[]

  @@index([industry, status])
  @@map("organisations")
}

model OrganisationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments    MemberRole[]

  @@unique([organisationId, userId])
  @@unique([id, organisationId])
  @@index([userId, status])
  @@index([organisationId, status])
  @@map("organisation_members")
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  name           String           @db.VarChar(80)
  isSystemRole   Boolean          @default(false) @map("is_system_role")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  assignments    MemberRole[]
  permissions    RolePermission[]
  invitations    OrganisationInvitation[]

  @@unique([organisationId, name])
  @@unique([id, organisationId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(120)
  description String           @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model MemberRole {
  organisationId String             @map("organisation_id") @db.Uuid
  memberId       String             @map("member_id") @db.Uuid
  roleId         String             @map("role_id") @db.Uuid
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  member         OrganisationMember @relation(fields: [memberId, organisationId], references: [id, organisationId], onDelete: Cascade)
  role           Role               @relation(fields: [roleId, organisationId], references: [id, organisationId], onDelete: Cascade)

  @@id([memberId, roleId])
  @@index([organisationId, roleId])
  @@map("member_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId, revokedAt])
  @@map("refresh_sessions")
}

model AuthToken {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  type        AuthTokenType
  tokenHash   String        @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?     @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
  @@map("auth_tokens")
}

model OrganisationInvitation {
  id             String        @id @default(uuid()) @db.Uuid
  organisationId String        @map("organisation_id") @db.Uuid
  roleId         String        @map("role_id") @db.Uuid
  invitedById    String        @map("invited_by_id") @db.Uuid
  email          String        @db.VarChar(320)
  tokenHash      String        @unique @map("token_hash") @db.VarChar(64)
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime?     @map("accepted_at") @db.Timestamptz(6)
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role           Role          @relation(fields: [roleId, organisationId], references: [id, organisationId], onDelete: Restrict)
  invitedBy      User          @relation("InvitationActor", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organisationId, email, expiresAt])
  @@index([organisationId, createdAt])
  @@map("organisation_invitations")
}

model EmailOutbox {
  id              String              @id @default(uuid()) @db.Uuid
  recipient       String              @db.VarChar(320)
  encryptedPayload String             @map("encrypted_payload") @db.Text
  status          EmailDeliveryStatus @default(PENDING)
  attempts        Int                 @default(0)
  nextAttemptAt   DateTime            @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt        DateTime?           @map("locked_at") @db.Timestamptz(6)
  lockToken       String?             @map("lock_token") @db.Uuid
  deliveredAt     DateTime?           @map("delivered_at") @db.Timestamptz(6)
  lastError       String?             @map("last_error") @db.VarChar(500)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt, createdAt])
  @@map("email_outbox")
}

model PlatformPermission {
  id          String              @id @default(uuid()) @db.Uuid
  key         String              @unique @db.VarChar(120)
  description String              @db.VarChar(255)
  grants      PlatformAdminGrant[]

  @@map("platform_permissions")
}

model PlatformAdminGrant {
  userId       String             @map("user_id") @db.Uuid
  permissionId String             @map("permission_id") @db.Uuid
  grantedById  String?            @map("granted_by_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User               @relation("PlatformGrantTarget", fields: [userId], references: [id], onDelete: Cascade)
  permission   PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy    User?              @relation("PlatformGrantActor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, permissionId])
  @@index([permissionId, userId])
  @@map("platform_admin_grants")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organisationId String?       @map("organisation_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  action         String        @db.VarChar(120)
  entityType     String?       @map("entity_type") @db.VarChar(100)
  entityId       String?       @map("entity_id") @db.VarChar(100)
  requestId      String?       @map("request_id") @db.VarChar(100)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SchoolProfile {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @unique @map("organisation_id") @db.Uuid
  schoolCode     String?      @map("school_code") @db.VarChar(40)
  timeZone       String       @default("Africa/Nairobi") @map("time_zone") @db.VarChar(80)
  weekStartsOn   Int          @default(1) @map("week_starts_on")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, schoolCode])
  @@map("school_profiles")
}

model SchoolAcademicYear {
  id             String             @id @default(uuid()) @db.Uuid
  organisationId String             @map("organisation_id") @db.Uuid
  name           String             @db.VarChar(100)
  startsOn       DateTime           @map("starts_on") @db.Date
  endsOn         DateTime           @map("ends_on") @db.Date
  status         AcademicYearStatus @default(DRAFT)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  terms          SchoolTerm[]
  sections       SchoolClassSection[]

  @@unique([id, organisationId])
  @@unique([organisationId, name])
  @@index([organisationId, status, startsOn])
  @@map("school_academic_years")
}

model SchoolTerm {
  id             String          @id @default(uuid()) @db.Uuid
  organisationId String          @map("organisation_id") @db.Uuid
  academicYearId String          @map("academic_year_id") @db.Uuid
  name           String          @db.VarChar(80)
  sequence       Int
  startsOn       DateTime        @map("starts_on") @db.Date
  endsOn         DateTime        @map("ends_on") @db.Date
  status         SchoolTermStatus @default(PLANNED)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  academicYear   SchoolAcademicYear @relation(fields: [academicYearId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@unique([id, organisationId])
  @@unique([organisationId, academicYearId, name])
  @@unique([organisationId, academicYearId, sequence])
  @@index([organisationId, academicYearId, startsOn])
  @@map("school_terms")
}

model SchoolGradeLevel {
  id             String                 @id @default(uuid()) @db.Uuid
  organisationId String                 @map("organisation_id") @db.Uuid
  name           String                 @db.VarChar(80)
  code           String                 @db.VarChar(20)
  sortOrder      Int                    @default(1) @map("sort_order")
  status         SchoolGradeLevelStatus @default(ACTIVE)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  organisation   Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  sections       SchoolClassSection[]

  @@unique([id, organisationId])
  @@unique([organisationId, name])
  @@unique([organisationId, code])
  @@index([organisationId, status, sortOrder])
  @@map("school_grade_levels")
}

model SchoolClassSection {
  id             String                    @id @default(uuid()) @db.Uuid
  organisationId String                    @map("organisation_id") @db.Uuid
  academicYearId String                    @map("academic_year_id") @db.Uuid
  gradeLevelId   String                    @map("grade_level_id") @db.Uuid
  name           String                    @db.VarChar(80)
  status         SchoolClassSectionStatus  @default(PLANNED)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  organisation   Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  academicYear   SchoolAcademicYear        @relation(fields: [academicYearId, organisationId], references: [id, organisationId], onDelete: Restrict)
  gradeLevel     SchoolGradeLevel          @relation(fields: [gradeLevelId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@unique([id, organisationId])
  @@unique([organisationId, academicYearId, gradeLevelId, name])
  @@index([organisationId, academicYearId, status])
  @@map("school_class_sections")
}